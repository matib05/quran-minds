# Copy to .env and fill in.
#
# Both URLs must carry the same `schema=` parameter: Prisma qualifies its own
# queries, but the few raw SQL statements read the schema name from this URL at
# runtime (see lib/prisma.js).

# --- A local PostgreSQL ---
POSTGRES_PRISMA_URL="postgresql://USER:PASS@localhost:5432/quranminds?schema=quranminds"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASS@localhost:5432/quranminds?schema=quranminds"

# --- Hosted (Neon, Supabase, Vercel Postgres) ---
# The pooled URL benefits from a bounded client-side pool; without it Prisma
# opens (cpus * 2 + 1) connections, which a serverless Postgres will refuse.
# POSTGRES_PRISMA_URL="postgres://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=5&pool_timeout=20&schema=quranminds"
# POSTGRES_URL_NON_POOLING="postgres://user:pass@host.region.aws.neon.tech/db?sslmode=require&schema=quranminds"

# Show the demo account list on the login page in production.
# SHOW_DEMO_ACCOUNTS="true"
